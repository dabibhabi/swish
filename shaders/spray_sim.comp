#version 450

// ── GPU road-spray particle simulation (W9) — the project's FIRST compute pass ──
// One invocation advances one particle IN PLACE: dead particles may respawn behind
// the car's rear axle (emission gated by wetness × speed, folded into emitProb on
// the CPU), live ones integrate under gravity + drag and age out. A single shared
// SSBO is simulated continuously (one dt step per frame → correct speed, one smooth
// population). 4096 particles, local size 64 (4096 % 64 == 0 → no bounds guard).

layout(local_size_x = 64) in;

struct Particle {
    vec4 posLife;  // xyz = world position (WU), w = life [0,1] (0 = dead)
    vec4 velSize;  // xyz = velocity (WU/s), w = billboard size (WU)
};

layout(set = 0, binding = 0) buffer Particles { Particle particles[]; };

layout(set = 0, binding = 1) uniform Sim {
    vec4 spawnPosDt;  // xyz = rear-axle spawn centre (WU), w = dt (s)
    vec4 carVel;      // xyz = car velocity (WU/s), w = emit probability [0,1]
    vec4 params;      // x = lifetime (s), y = size base (WU), z = gravity (WU/s²), w = drag (1/s)
    vec4 params2;     // x = lateral spread (WU), y = frame seed, z = up speed (WU/s), w = back speed (WU/s)
} sim;

// Hash-based RNG (bit-mixing) → [0,1).
#include "hash11.glsl"

void main() {
    uint  i  = gl_GlobalInvocationID.x;
    float dt = sim.spawnPosDt.w;

    Particle pt   = particles[i];
    float    life = pt.posLife.w;

    // Per-particle, per-frame seed so respawns + directions decorrelate over time.
    uint  s  = i * 747796405u + uint(sim.params2.y) * 2891336453u;
    float r0 = hash11(s);
    float r1 = hash11(s + 1u);
    float r2 = hash11(s + 2u);
    float r3 = hash11(s + 3u);

    if (life <= 0.0) {
        // Respawn (probabilistic) behind the rear axle, biased backward + upward.
        if (r0 < sim.carVel.w) {
            vec3  fwd = sim.carVel.xyz;
            float sp  = length(fwd);
            fwd       = (sp > 1.0) ? fwd / sp : vec3(0.0, 0.0, -1.0);
            vec3 lateral = normalize(cross(fwd, vec3(0.0, 1.0, 0.0)) + vec3(1e-4, 0.0, 0.0));

            // Fake two tire-width jets out of this single emitter (real per-wheel
            // emitters need host-side plumbing — see needsHostSideWork): alternate
            // particle *slots* between a left and right cluster at ±65% of the
            // configured spread, each with only a tight ±22% in-jet jitter, instead
            // of scattering every particle uniformly across the full car width. The
            // slot index (not a per-frame random) keeps each side stable frame to
            // frame instead of flickering between clusters.
            float side          = ((i & 1u) == 0u) ? -1.0 : 1.0;
            float inJet         = r1 * 2.0 - 1.0;                  // -1..1 jitter within the jet
            float clusterOffset = side * 0.65 + inJet * 0.22;      // two tight lobes, not one wide fan

            vec3 pos = sim.spawnPosDt.xyz
                     + lateral * clusterOffset * sim.params2.x     // tight jet, biased ±wheel-ish
                     + vec3(0.0, r2 * 0.15 * sim.params2.x, 0.0);  // slight launch height
            // Kicked back relative to travel + up. The lateral kick reuses the same
            // clusterOffset (not an independent random) so a jet keeps pushing the
            // direction it spawned toward rather than criss-crossing into a wide fan
            // — that divergence is what read as a solid fog blob.
            vec3 vel = -fwd * sim.params2.w * (0.5 + 1.0 * r3)
                     + vec3(0.0, 1.0, 0.0) * sim.params2.z * (0.5 + 0.8 * r2)
                     + lateral * clusterOffset * sim.params2.z * 0.35;

            pt.posLife = vec4(pos, 1.0);
            pt.velSize = vec4(vel, sim.params.y * (0.6 + 0.8 * r1));
        } else {
            pt.posLife.w = 0.0;  // stay dead
        }
    } else {
        vec3 vel = pt.velSize.xyz;
        vel.y   += sim.params.z * dt;                 // gravity (params.z is negative)

        // Per-step turbulence, now ANISOTROPIC around the current travel direction
        // instead of uniform on all three axes: a large kick along the path only
        // varies how far a droplet reaches (it still reads as the same streak),
        // while a much smaller kick across it barely bends the trajectory — that
        // lateral/vertical randomization was what shredded straight streaks into a
        // cloud. Magnitude also decays with life (strongest right at launch, ~0
        // near death) so the jet is only chaotic at the contact patch and settles
        // into a clean ballistic arc for the rest of its flight.
        float spd   = length(vel);
        vec3  dir   = (spd > 1.0) ? vel / spd : vec3(0.0, 0.0, -1.0);
        vec3  perp1 = normalize(cross(dir, vec3(0.0, 1.0, 0.0)) + vec3(1e-4, 0.0, 0.0));
        vec3  perp2 = cross(dir, perp1);

        uint  ts      = i * 2654435761u + uint(sim.params2.y) * 40503u;
        vec3  turbRaw = vec3(hash11(ts) - 0.5, hash11(ts + 1u) - 0.5, hash11(ts + 2u) - 0.5);
        float decay   = life * life;      // quadratic: chaotic early, coherent later
        float along   = 3200.0 * decay;   // along-path: jitters reach, not direction
        float across  = 450.0 * decay;    // lateral/vertical: ~7x weaker, keeps the streak straight

        vec3 turb = dir * turbRaw.x * along + perp1 * turbRaw.y * across + perp2 * turbRaw.z * across;
        vel      += turb * dt;

        vel     *= max(1.0 - sim.params.w * dt, 0.0); // air drag
        vec3 pos = pt.posLife.xyz + vel * dt;
        life    -= dt / max(sim.params.x, 0.01);
        pt.posLife     = vec4(pos, max(life, 0.0));
        pt.velSize.xyz = vel;
    }

    particles[i] = pt;
}
