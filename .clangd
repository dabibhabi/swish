# clangd configuration for swish (Vulkan 1.3 / MoltenVK, C++17, CMake)
#
# compile_commands.json is generated into build/ by CMake
# (CMAKE_EXPORT_COMPILE_COMMANDS ON in CMakeLists.txt, line 6). build/ is
# gitignored, so we point clangd at it rather than committing a copy.
CompileFlags:
  # Directory (relative to this file) that contains compile_commands.json.
  CompilationDatabase: build
  # Apple clangd matches /usr/bin/c++; keep its own builtin/SDK search paths.
  Add:
    - -std=gnu++17
  # -W flags in the DB that Apple clangd doesn't recognise would spam
  # diagnostics; drop unknown-warning noise if it ever appears.
  Remove:
    - -W*

# Index the whole project in the background so Find All References is complete.
Index:
  Background: Build

Diagnostics:
  UnusedIncludes: Strict
  # clang-tidy checks surfaced inline; keep it light to avoid noise.
  ClangTidy:
    Add:
      - performance-*
      - bugprone-*
    Remove:
      - bugprone-easily-swappable-parameters
