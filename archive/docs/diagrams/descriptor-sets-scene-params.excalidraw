      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "binding 0: CameraUBO\n  view, proj, camPos(.w=wetness)\n  sunDir, sunColor, weather\n  cascadeViewProj[3] + cascadeSplits\nbinding 1: LightsUBO (32 point lights)",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top"
    },
