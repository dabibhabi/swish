            "file": 1,
            "line": 2,
            "severity": "error",
            "message": 3
          }
        },
        {
          "owner": "glslang",
          "pattern": {
            "regexp": "^WARNING: (.*):([0-9]+): (.*)$",
            "file": 1,
            "line": 2,
            "severity": "warning",
            "message": 3
          }
        }
      ]
    },
    {
      "label": "Shader: Compile current Vulkan GLSL to SPIR-V",
      "type": "process",
      "command": "${workspaceFolder}/tools/shader-tools.sh",
      "args": [
        "compile-vulkan",
