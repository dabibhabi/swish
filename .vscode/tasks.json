      "command": "${workspaceFolder}/tools/shader-tools.sh",
      "args": [
        "compile-vulkan-project"
      ],
      "problemMatcher": [
        "$gcc",
        {
          "owner": "glslang",
          "pattern": {
            "regexp": "^ERROR: (.*):([0-9]+): (.*)$",
            "file": 1,
