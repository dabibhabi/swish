// ── Wheel-track ruts ─ ImGui header "Wet / Rain", TOML table [ruts] (rain round 3, P3) ── Debug-only: GeometryProducer
// pushes the asphalt UV tile (extra.w) so gbuffer.frag can find the lanes; lighting.frag / ssr.frag turn the decoded rut
// into standing water. NOPUSH: packed by hand. rut_uv_tile MUST equal road.toml [tiling] asphalt (3000 WU).
TUNE_B(rutEnabled, "ruts", "enabled", true, "Wheel-track ruts##ruts", NOREL)
TUNE_F(rutUvTile, "ruts", "uv_tile", 3000.0f, 500.0f, 10000.0f, "Asphalt UV tile (WU, = road.toml)", "%.0f", 0, NOPUSH, NOREL)
TUNE_F(rutWater, "ruts", "water", 0.85f, 0.0f, 1.0f, "Rut water", "%.3f", 3, NOPUSH, NOREL)
TUNE_F(rutRoughness, "ruts", "roughness", 0.06f, 0.02f, 0.5f, "Rut water roughness", "%.3f", 3, NOPUSH, NOREL)

// ── Rain ripples ─ ImGui header "Wet / Rain", TOML table [ripples] (rain round 3, P4) ── Debug-only: procedural rings
