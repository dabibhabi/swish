      "width": 210,
      "height": 114,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "roundness": null,
      "text": "grazing = (1 \u2212 N\u00b7V)^4\nfres = 0.04 + 0.96\u00b7grazing\nedge fade (screen border)\nweight = reflectivity\u00b7fres\u00b7intensity\nout.rgb = hitCol\u00b7fade\u00b7weight\ncomposite: hdr += ssr.rgb",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top"
