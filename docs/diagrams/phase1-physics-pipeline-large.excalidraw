    { "id": "footer", "type": "text", "x": 40, "y": 460, "width": 1150, "height": 90, "angle": 0, "strokeColor": "#6272a4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 123, "version": 1, "versionNonce": 123, "isDeleted": false, "boundElements": [], "updated": 1735000000000, "link": null, "locked": false, "roundness": null,
      "text": "No electronic driver-aid state machine (no launch control / PSM / ABS) — 2.8s 0-60, ~205 mph top speed, and the AWD launch feel are all meant to emerge from\nthe tire friction-circle + PTU torque split above, the same way the current RWD traction-cap model is emergent today. Suspension camber/toe curves are derived\noffline once from real double-wishbone-front / multi-link-rear hardpoint geometry, then evaluated as a cheap per-frame lookup — no runtime constraint solver.",
      "fontSize": 12, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top" }
