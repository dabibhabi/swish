    { "id": "t4", "type": "text", "x": 770, "y": 90, "width": 190, "height": 84, "angle": 0, "strokeColor": "#f1fa8c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 107, "version": 1, "versionNonce": 107, "isDeleted": false, "boundElements": [], "updated": 1735000000000, "link": null, "locked": false, "roundness": null, "text": "Tire friction circle\nF_x² + F_y² ≤ (μ·F_z)²\nper-corner load transfer\n(longitudinal + lateral)", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle" },

