    { "id": "footer", "type": "text", "x": 40, "y": 560, "width": 1000, "height": 60, "angle": 0, "strokeColor": "#6272a4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 19, "version": 1, "versionNonce": 19, "isDeleted": false, "boundElements": [], "updated": 1735000000000, "link": null, "locked": false, "roundness": null,
      "text": "One real risk called out during grilling: the tire-slip formulas in CarPhysics.h have never been verified at negative vx (car sliding\nbackward mid-spin) — Phase 2's implementation work includes validating (and likely fixing sign-symmetry in) that math before relying on it.",
      "fontSize": 12, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top" }
