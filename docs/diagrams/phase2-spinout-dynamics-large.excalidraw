    { "id": "t6", "type": "text", "x": 370, "y": 434, "width": 280, "height": 72, "angle": 0, "strokeColor": "#bd93f9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 17, "version": 1, "versionNonce": 17, "isDeleted": false, "boundElements": [], "updated": 1735000000000, "link": null, "locked": false, "roundness": null, "text": "Skill-based recovery loop\ncountersteer + throttle lift → μ recovers\nas speed drops / car exits the puddle →\nclamp re-engages, same continuous model", "fontSize": 12, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle" },

